.module-body {
  padding-top: var(--space-7);
  padding-bottom: var(--space-10);
  display: flex;
  flex-direction: column;
  gap: var(--space-7);
}

.mod-card {
  background: var(--color-white);
  border: 1px solid var(--color-line);
  border-radius: var(--radius-md);
  padding: var(--space-7);
}

.mod-card__header {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.challenge-box {
  margin-top: var(--space-5);
  padding: var(--space-5);
  background: var(--color-paper-alt);
  border-left: 3px solid var(--color-accent);
  border-radius: var(--radius-sm);
}

.scenario-quote {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-style: italic;
  color: var(--color-accent-strong);
  margin: var(--space-3) 0;
}

.grid-2col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-6);
}

@media (max-width: 768px) {
  .grid-2col { grid-template-columns: 1fr; }
}

.styled-list li {
  padding: var(--space-2) 0;
  border-bottom: 1px solid var(--color-line);
}

.roadmap-timeline {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.roadmap-timeline .step {
  padding: 8px var(--space-3);
  background: var(--color-paper-alt);
  border-radius: var(--radius-sm);
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--color-slate);
}

.roadmap-timeline .step.active {
  color: var(--color-accent-strong);
  border: 1px solid var(--color-accent);
}

.roadmap-timeline .step.highlight {
  color: var(--color-ink);
  background: var(--color-navy-deep);
}

.poll-options {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-top: var(--space-4);
}

.poll-btn {
  text-align: left;
  padding: 12px var(--space-4);
  background: var(--color-paper-alt);
  border: 1px solid var(--color-line);
  border-radius: var(--radius-sm);
  transition: background var(--dur-fast) var(--ease);
  cursor: pointer;
}

.poll-btn:hover {
  border-color: var(--color-accent);
}

.vocab-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: var(--space-4);
  margin-top: var(--space-4);
}

.vocab-card {
  background: var(--color-paper-alt);
  border: 1px solid var(--color-line);
  border-radius: var(--radius-sm);
  padding: var(--space-4);
  cursor: pointer;
  min-height: 110px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  transition: border-color var(--dur-fast) var(--ease);
}

.vocab-card:hover { border-color: var(--color-accent); }
.vocab-term { font-family: var(--font-mono); color: var(--color-accent-strong); font-weight: 500; }
.vocab-def { display: none; font-size: 0.85rem; margin-top: 6px; color: var(--color-ink-soft); }
.vocab-card.flipped .vocab-term { display: none; }
.vocab-card.flipped .vocab-def { display: block; }

.passbook-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: var(--space-4);
  font-family: var(--font-mono);
  font-size: 0.9rem;
}

.passbook-table th, .passbook-table td {
  padding: 10px;
  border: 1px solid var(--color-line);
  text-align: left;
}

.passbook-table th { background: var(--color-paper-alt); color: var(--color-accent-strong); }

.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: var(--space-4);
  margin-top: var(--space-4);
}

.product-card {
  padding: var(--space-4);
  background: var(--color-paper-alt);
  border-radius: var(--radius-sm);
  border: 1px solid var(--color-line);
}

.flow-steps {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-3);
  margin-top: var(--space-4);
}

.flow-step {
  background: var(--color-paper-alt);
  padding: 12px 18px;
  border-radius: var(--radius-sm);
  font-family: var(--font-mono);
  font-size: 0.9rem;
  border: 1px solid var(--color-line);
}

.flow-step span {
  color: var(--color-accent-strong);
  margin-right: 6px;
}

.flow-arrow { color: var(--color-slate); font-weight: bold; }

.deposit-form {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-top: var(--space-4);
  max-width: 480px;
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.form-row label {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--color-slate);
}

.form-row input {
  padding: 10px;
  background: var(--color-paper-alt);
  border: 1px solid var(--color-line);
  border-radius: var(--radius-sm);
  color: var(--color-ink);
  font-family: var(--font-body);
}

.reflection-input, .reflection-single {
  width: 100%;
  padding: 10px;
  background: var(--color-paper-alt);
  border: 1px solid var(--color-line);
  border-radius: var(--radius-sm);
  color: var(--color-ink);
  margin-top: 10px;
}

.reflection-input { min-height: 90px; resize: vertical; }

.feedback-text {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  font-weight: 500;
  margin-top: 10px;
}
